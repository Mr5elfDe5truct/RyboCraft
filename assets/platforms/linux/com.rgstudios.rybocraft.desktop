[Desktop Entry]
Type=Application
Name=RyboCraft
GenericName=3D CAD
Comment=Parametric 3D CAD: sketch, constrain, extrude, and change a parameter to rebuild
Exec=rybocraft %f
TryExec=rybocraft
Icon=com.rgstudios.rybocraft
Terminal=false
StartupNotify=true
StartupWMClass=com.rgstudios.rybocraft
Categories=Graphics;3DGraphics;Engineering;
Keywords=cad;3d;parametric;sketch;step;stl;modelling;modeling;
MimeType=application/x-rybocraft;model/step;model/iges;model/stl;model/3mf;
# Desktop ids of earlier releases; launchers keep pinned entries across the renames.
X-Flatpak-RenamedFrom=com.rgstudios.solidcraft.desktop;com.rgstudios.solidcraft-beta.desktop;
